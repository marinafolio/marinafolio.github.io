---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const writingSamples = await getCollection("writing-samples");

  return writingSamples.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<"writing-samples">;
};

const { entry } = Astro.props as Props;
const { Content } = await entry.render();
---

<Layout>
  <div class="container">
    <div id="project-container">
      <section>
        <h1 id="project-heading">{entry.data.title}</h1>

        {
          entry.data.tags && entry.data.tags.length > 0 && (
            <p class="focus">
              <strong>Focus:</strong> {entry.data.tags.join(", ")}
            </p>
          )
        }

        <Content />
      </section>
    </div>
  </div>
</Layout>
